# AutoSignUp — the only env file it reads (copy to .env, chmod 600).

# The production atlasagents-app database. On the prod server Postgres listens
# on 127.0.0.1:5432. Use the restricted role from deploy/create-role.sql
# (recommended) or the app's own DATABASE_URL from /opt/redesigned-giggle/.env.
# Only 127.0.0.1 / localhost hosts are accepted.
DATABASE_URL=postgresql://autosignup:CHANGE_ME@127.0.0.1:5432/sovereignml

# Calendar days for the daily cap are counted in this zone.
AUTOSIGNUP_TZ=Asia/Dhaka

# Where the records live (job files with plain-text passwords, the pool,
# settings). Back this folder up; keep it private.
AUTOSIGNUP_DATA_DIR=/var/lib/autosignup
